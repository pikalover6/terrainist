            17,
            14,
            25
          ]
        },
        {
          "id": "greek_siege_remnant",
          "mode": "plugin",
          "brief": "Abandoned Greek siege camp traces: cold ash firepits, broken timber stakes, discarded bronze-rimmed shields, amphora crates, and abandoned supply palisades on the coastal plain.",
          "envelope": [
            7,
            5,
            7
          ],
          "count": 8
        }
      ]
    },
    "tokens": {
      "terrain": "a walled citadel city on a coastal rise above a sandy plain; the Aegean shore and open sea in view",
      "icons": "the colossal wooden Trojan horse brought inside the Scaean gate; monumental stone ramparts and watchtowers; royal megaron palace overlooking the city; abandoned Greek camp and beached ship hulls on the distant shore",
