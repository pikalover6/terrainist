            13,
            19,
            17
          ]
        },
        {
          "id": "temple_of_athena_troy",
          "mode": "landmark",
          "brief": "A grand archaic peripteral temple on a multi-stepped limestone crepidoma with fluted sandstone columns, a bronze-trimmed inner cella containing an altar to Athena, sacrificial braziers, and votive tripods overlooking the citadel.",
