          "amplitude": 14,
          "baseHeight": 72,
          "seaLevel": 63,
          "octaves": 4,
          "frequency": 0.0038,
          "gain": 0.46,
          "lacunarity": 2.0,
          "erosionPasses": 2,
          "cliffThreshold": 60,
          "soilDepth": 4,
          "beachWidth": 4,
          "snowLineFraction": 0.98
        },
        "children": [
          {
            "id": "the_bay",
            "kind": "generator",
            "generator": "terrain.edit@0",
            "label": "The bay the harbour works",
            "params": {
              "verb": "basin",
              "at": [0.5, 1.0],
              "radius": 170,
              "depth": 12,
              "profile": "rounded",
              "irregularity": 0.15
            }
          },
          {
            "id": "harbour_shelf",
            "kind": "generator",
            "generator": "terrain.edit@0",
            "label": "The low shelf the quay is cut into",
            "params": {
              "verb": "plateau",
              "at": [0.5, 0.42],
              "radius": 90,
              "height": 4,
              "profile": "rounded"
            }
          }
        ]
      },
      {
        "id": "climate",
        "kind": "generator",
        "generator": "terrain.climate@0",
        "params": { "forceTheme": "temperate", "blendRadius": 8 }
      },
      {
        "id": "hinterland",
        "kind": "generator",
        "generator": "scatter.forest@0",
