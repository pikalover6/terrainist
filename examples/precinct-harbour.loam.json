          "area": { "zone": "north" },
          "density": 0.09,
          "spacing": 4,
          "clumping": 0.5,
          "maxSlope": 32,
          "elevation": [3, 90],
          "edgeFalloff": 12,
          "avoidTags": ["structure", "road", "plaza", "precinct"],
          "species": [{ "id": "shore_oak", "weight": 1, "shape": "oak_round" }]
        }
      },
      {
        "id": "port",
