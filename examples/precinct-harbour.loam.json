        "tags": ["shop"]
      },
      {
        "id": "lanes",
        "kind": "generator",
        "generator": "road.network@0",
        "label": "The lane from the town down to the quay",
        "params": {
          "anchors": ["harbourmaster", "chandlery", "port"],
