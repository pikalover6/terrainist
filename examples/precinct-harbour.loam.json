{
  "loam": "0.1",
  "profile": "settlement",
  "meta": {
    "name": "precinct_harbour",
    "worldSeed": 5566778899,
    "prompt": "A working harbour on a southern bay: a stone quay along the waterline, three piers running out from it, boats moored alongside on one heading, gantry cranes on the quay, a warehouse and a boathouse behind, and a lane up to the harbourmaster's house.",
    "spawn": { "zone": "north" }
  },
  "style": {
    "palettes": { "road.surface": "minecraft:cobblestone" }
  },
  "root": {
    "id": "world",
    "kind": "composite",
    "label": "A working harbour on a southern bay",
    "envelope": { "shape": "region", "size": [320, 320] },
    "children": [
      {
        "id": "terrain",
        "kind": "generator",
        "generator": "terrain.heightfield@0",
        "label": "Low country falling to a southern bay",
