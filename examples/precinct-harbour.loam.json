        "ports": { "front": { "type": "door", "face": "south" } },
        "tags": ["house"]
      },
      {
        "id": "chandlery",
        "kind": "generator",
        "generator": "building.grammar@0",
        "label": "The chandlery",
        "envelope": { "shape": "box", "size": [11, 8, 9] },
        "params": { "floors": 2, "roof": "gable" },
        "constraints": [{ "zone": "west" }],
