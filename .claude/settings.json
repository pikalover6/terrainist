{
  "permissions": {
    "allow": [
      "Bash(tailscaled *)",
      "Bash(tailscale *)",
      "Bash(/usr/local/bin/tailscaled *)",
      "Bash(/usr/local/bin/tailscale *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
